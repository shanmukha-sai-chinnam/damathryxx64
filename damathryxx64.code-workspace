    "settings": {
        "workbench.settings.editor": "json",
        "task.allowAutomaticTasks": "on",
        // Antigravity Engine & Semantic Codebase Search
        "antigravity.searchMaxWorkspaceFileCount": 10000,
        "antigravity.persistentLanguageServer": true,
        // Editor Font & Display
        "editor.fontFamily": "'CaskaydiaCove Nerd Font', 'CaskaydiaCove NF', 'FiraCode Nerd Font', 'Cascadia Code NF', Consolas, 'Courier New', 'MesloLGS NF', monospace",
        "editor.fontLigatures": true,
        "editor.fontVariations": true,
        "editor.codeLensFontFamily": "'CaskaydiaCove Nerd Font', 'CaskaydiaCove NF', 'FiraCode Nerd Font', 'Cascadia Code NF', Consolas, 'Courier New', 'MesloLGS NF', monospace",
        "editor.fontSize": 15,
        // Editor Behavior
        "editor.formatOnPaste": true,
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.autoClosingBrackets": "languageDefined",
        "editor.cursorStyle": "underline",
        "editor.wordWrap": "wordWrapColumn",
        "editor.suggestSelection": "first",
        "editor.acceptSuggestionOnEnter": "smart",
        "editor.quickSuggestionsDelay": 0,
        "editor.snippetSuggestions": "top",
        // Editor Display & Visual Layout
        "editor.minimap.enabled": false,
        "editor.scrollbar.verticalScrollbarSize": 0,
        "editor.renderWhitespace": "trailing",
        "editor.renderControlCharacters": true,
        "editor.renderFinalNewline": "on",
        "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
        "editor.guides.bracketPairs": true,
        "editor.guides.indentation": true,
        "editor.stickyScroll.enabled": true,
        // Diff Editor & Antigravity Agent Review
        "diffEditor.codeLens": true,
        "diffEditor.wordWrap": "inherit",
        "diffEditor.ignoreTrimWhitespace": false,
        "diffEditor.renderSideBySide": false,
        "diffEditor.experimental.showMoves": true,
        "scm.diffDecorations": "all",
        // File Management
        "files.autoSave": "onWindowChange",
        "files.autoSaveWorkspaceFilesOnly": true,
        "files.autoGuessEncoding": true,
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        // File Watcher Exclusions (Protect Antigravity & Nix Store from Derivation Flooding)
        "files.watcherExclude": {
            "**/.git/objects/**": true,
            "**/.git/subtree-cache/**": true,
            "**/result/**": true,
            "**/.direnv/**": true,
            "**/.venv/**": true,
            "**/target/**": true
        },
        // Search & Indexing Exclusions
        "search.showLineNumbers": true,
        "search.smartCase": true,
        "search.useGlobalIgnoreFiles": true,
        "search.useParentIgnoreFiles": true,
        "search.exclude": {
            "**/result": true,
            "**/.direnv": true,
            "**/.venv": true,
            "**/target": true
        },
        // Terminal & WSL Integration
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.cursorBlinking": true,
        "terminal.integrated.persistentSessionReviveProcess": "never",
        "terminal.integrated.enableMultiLinePasteWarning": "always",
        "terminal.integrated.fontFamily": "'CaskaydiaCove Nerd Font', 'CaskaydiaCove NF', 'FiraCode Nerd Font', 'Cascadia Code NF', 'Cascadia Mono NF', 'MesloLGS NF', Consolas, 'Courier New', monospace",
        "terminal.integrated.unicodeVersion": "11",
        "terminal.integrated.scrollback": 10000,
        "terminal.integrated.smoothScrolling": true,
        // Explorer
        "explorer.excludeGitIgnore": true,
        "explorer.autoReveal": true,
        "explorer.confirmDelete": false,
        "explorer.confirmDragAndDrop": false,
        // Workbench
        "workbench.startupEditor": "none",
        "workbench.editor.enablePreview": false,
        "workbench.editor.highlightModifiedTabs": true,
        "workbench.editor.limit.enabled": true,
        "workbench.editor.limit.value": 8,
        "workbench.statusBar.visible": true,
        "window.zoomLevel": 0.5,
        // Git Version Control
        "git.autofetch": true,
        "git.suggestSmartCommit": false,
        "git.enableSmartCommit": true,
        "git.confirmSync": false,
        "git.openRepositoryInParentFolders": "never",
        "git.rebaseWhenSync": true,
        "git.defaultBranchName": "trunk",
        "git.enableCommitSigning": false,
        // Nix Language Server (nixd) & Formatter (Alejandra)
        "alejandra.program": "alejandra",
        "nix.enableLanguageServer": true,
        "nix.serverPath": "nixd",
        "nix.serverSettings": {
            "nixd": {
                "formatting": {
                    "command": [
                        "alejandra"
                    ]
                },
                "options": {
                    "nixos": {
                        "expr": "(builtins.getFlake \"${workspaceFolder:damathryxx64}\").nixosConfigurations.nixos.options"
                    }
                }
            }
        },
        // Language-Specific Formatting & Indentation
        "[nix]": {
            "editor.formatOnSave": true,
            "editor.tabSize": 2
        },
        "[markdown]": {
            "editor.wordWrap": "on",
            "editor.quickSuggestions": {
                "comments": "off",
                "strings": "off",
                "other": "off"
            }
        },
        "[yaml]": {
            "editor.tabSize": 2
        },
        "[json]": {
            "editor.defaultFormatter": "vscode.json-language-features",
            "editor.tabSize": 2
        },
        "[jsonc]": {
            "editor.defaultFormatter": "vscode.json-language-features",
            "editor.tabSize": 4
        }
    }
}
